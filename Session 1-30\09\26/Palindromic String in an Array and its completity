# First Palindromic String in an Array

n = int(input())
arr = input().split()

for word in arr:
    if word == word[::-1]:
        print("First Palindrome:", word)
        break
else:
    print("No Palindrome")

# Time Complexity: O(n * k)
# Space Complexity: O(k)
# n = number of strings
# k = maximum length of a string
